rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /conferencias/{tombo} {
      allow read, write: if request.auth != null;
    }
    match /novosEquipamentos/{id} {
      allow read, write: if request.auth != null;
    }
    match /configuracoesCadastro/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
